{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "app/**/*.ts",
    "app/**/*.tsx",
    "src/**/*.ts",
    ".expo/types/**/*.d.ts",
    "index.ts"
  ],
  "exclude": [
    "**/__tests__/**",
    "node_modules"
  ]
}
