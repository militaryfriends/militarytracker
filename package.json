{
  "name": "militarytracker-rn",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@expo-google-fonts/barlow-condensed": "^0.4.1",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "^58.0.0",
    "expo-constants": "~58.0.15",
    "expo-dev-client": "~58.0.18",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-gl": "~58.0.4",
    "expo-haptics": "~58.0.7",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.16",
    "expo-notifications": "~58.1.8",
    "expo-router": "~58.0.30",
    "expo-splash-screen": "~58.0.13",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-updates": "~58.0.21",
    "expo-video": "~58.0.13",
    "firebase": "^11.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-purchases": "^10.15.1",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0",
    "three": "^0.186.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "@types/three": "^0.186.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/engine-sync.mjs --check && node scripts/test.mjs",
    "engine:sync": "node scripts/engine-sync.mjs",
    "check:theme": "node scripts/check-theme.mjs",
    "media:report": "node scripts/media-report.mjs",
    "deploy:rules": "firebase deploy --only firestore:rules,firestore:indexes,storage",
    "deploy:hosting": "npx expo export --platform web && firebase deploy --only hosting",
    "deploy:functions": "firebase deploy --only functions",
    "media:upload": "node scripts/upload-videos.mjs",
    "media:r2": "node scripts/media-r2.mjs",
    "check:plans": "npx -y esbuild@0.24.0 scripts/plan-check.ts --bundle --platform=node --outfile=.cache/plan-check.cjs --loader:.json=json --log-level=error && node .cache/plan-check.cjs",
    "check:scenarios": "npx -y esbuild@0.24.0 scripts/scenario-check.ts --bundle --platform=node --outfile=.cache/scenario-check.cjs --loader:.json=json --log-level=error && node .cache/scenario-check.cjs"
  },
  "private": true
}
