{
  "expo": {
    "name": "밀리터리트래커",
    "slug": "militarytracker",
    "version": "1.2.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/cfaeff49-5bc0-49a6-9a8b-34f6d040b3f4",
      "fallbackToCacheTimeout": 0,
      "checkAutomatically": "ON_LOAD"
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "militarytracker",
    "backgroundColor": "#09090A",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.militarytracker.app",
      "userInterfaceStyle": "automatic",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#09090A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.militarytracker.app",
      "userInterfaceStyle": "automatic",
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 208,
          "resizeMode": "contain",
          "backgroundColor": "#09090A"
        }
      ],
      "expo-font",
      "expo-status-bar",
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "cfaeff49-5bc0-49a6-9a8b-34f6d040b3f4"
      }
    },
    "owner": "militaryfriends-official"
  }
}
