# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local
.env

# Firebase — .firebaserc 는 프로젝트 ID 뿐이라 커밋한다(새 클론에서 firebase deploy 가 프로젝트를 찾도록)

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# Cloud Functions build output
functions/lib/

# Firebase 디버그 로그
firebase-debug.log
*-debug.log
firestore-debug.log

# (구버전 경로) 영상은 이제 버킷에 있다 — media/originals/ 참조
/assets/video/

# Firebase Hosting 배포 캐시
.firebase/

# 영상 인코딩 작업 폴더 (scripts/upload-videos.mjs)
.cache/

# 운동 영상 원본 — 부위당 100~200MB, 절대 커밋하지 않는다 (media/README.md)
media/originals/

# 폴더 연결(FUSE) 중 생기는 임시 파일 — 커밋하지 않는다
.fuse_hidden*
