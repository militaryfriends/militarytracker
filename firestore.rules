rules_version = '2';

// MilitaryTracker — Firestore 보안 규칙
// 원칙: 본인 데이터만 읽고 쓴다. role == 'admin' 계정(또는 admin 클레임)은 전체 허용.
//
// 서버 전용 필드(users.sub / users.usage / users.coachUsage / users.role)는
// 클라이언트가 "수정" 도 "삭제" 도 할 수 없다. update 의 request.resource.data 는
// 쓰기 *후* 문서라 `!('sub' in request.resource.data)` 식 검사는 deleteField() 를
// 통과시킨다 — 그래서 diff().affectedKeys() 로 잠근다.
// users 문서 삭제도 클라이언트에겐 없다(지우고 다시 만들면 같은 우회가 된다).
// 계정 삭제는 accountDelete 콜러블(Admin SDK)이 한다.
service cloud.firestore {
  match /databases/{database}/documents {

    // ── 공통 함수 ─────────────────────────────────────────────────────────
    function signedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(uid())).data;
    }

    // 관리자 판정
    //  1) 커스텀 클레임 admin == true  → 문서 read 비용 없음 (권장)
    //  2) users/{uid}.role == 'admin'  → 콘솔에서 필드만 바꿔도 적용
    function isAdmin() {
      return signedIn() && (
        request.auth.token.admin == true ||
        (exists(/databases/$(database)/documents/users/$(uid())) && userDoc().role == 'admin')
      );
    }

    function isOwner(ownerId) {
      return signedIn() && uid() == ownerId;
    }

    function ownsExisting() {
      return signedIn() && resource.data.userId == uid();
    }

    function ownsIncoming() {
      return signedIn() && request.resource.data.userId == uid();
    }

    // 서버 전용 필드는 추가·수정·삭제 어느 것도 클라이언트가 못 한다
    function serverFieldsUntouched() {
      return !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['role', 'sub', 'usage', 'coachUsage']);
    }

    function isDate(v) {
      return v is string && v.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}');
    }

    function isIso(v) {
      return v is string && v.size() >= 20 && v.size() <= 40;
    }

    // 온보딩 프로필 — 화면 입력 그대로의 작은 문자열·숫자만
    function validProfile(p) {
      return p is map
        && p.keys().hasOnly([
          'sex', 'age', 'height', 'weight', 'goal', 'env', 'days', 'level', 'food', 'allergy',
          'waistCm', 'goalArchetypeId'
        ])
        && p.sex in ['male', 'female']
        && p.age is string && p.age.size() <= 4
        && p.height is string && p.height.size() <= 6
        && p.weight is string && p.weight.size() <= 6
        && p.goal in ['muscle', 'cut', 'habit']
        && p.env in ['gym', 'home']
        && p.days is int && p.days >= 2 && p.days <= 6
        && p.level is int && p.level >= 1 && p.level <= 3
        && p.food in ['convenience', 'self', 'family', 'out']
        && p.allergy is string && p.allergy.size() <= 200
        // 내 변화 프로젝트 온보딩(O3 허리둘레 · O2 목표 체형 카드) — 둘 다 선택
        && (!('waistCm' in p) || (p.waistCm is number && p.waistCm >= 50 && p.waistCm <= 200))
        && (!('goalArchetypeId' in p) || (p.goalArchetypeId is string && p.goalArchetypeId.size() <= 20));
    }

    // users 문서의 허용 키. update 의 request.resource.data 는 쓰기 후 문서 전체라
    // 서버 전용 키(sub/usage/coachUsage)도 목록에 있어야 한다 — 그것들의 변경은
    // serverFieldsUntouched() 가 따로 막는다.
    function validUserWrite(d) {
      return d.keys().hasOnly([
        'email', 'displayName', 'photoURL', 'authProvider', 'role', 'onboardingDone',
        'profile', 'createdAt', 'lastLoginAt', 'stats', 'sub', 'usage', 'coachUsage'
      ])
        && (!('displayName' in d) || d.displayName == null || (d.displayName is string && d.displayName.size() <= 40))
        && (!('email' in d) || d.email == null || (d.email is string && d.email.size() <= 254))
        && (!('onboardingDone' in d) || d.onboardingDone is bool)
        && (!('profile' in d) || d.profile == null || validProfile(d.profile))
        // 개인 기록 요약 — 종목 수만큼의 작은 맵
        && (!('stats' in d) || (d.stats is map && d.stats.keys().size() <= 4));
    }

    // ── users ─────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();

      // 가입 시 본인 문서 생성 — 스스로 admin 이나 구독·사용량을 부여할 수 없다
      allow create: if (isOwner(userId)
                        && request.resource.data.role == 'user'
                        && !('sub' in request.resource.data)
                        && !('usage' in request.resource.data)
                        && !('coachUsage' in request.resource.data)
                        && validUserWrite(request.resource.data)) || isAdmin();
      allow update: if (isOwner(userId)
                        && serverFieldsUntouched()
                        && validUserWrite(request.resource.data)) || isAdmin();
      // 삭제는 accountDelete 콜러블(서버)만
      allow delete: if isAdmin();
    }

    // ── plans/{uid} ───────────────────────────────────────────────────────
    function validPlan(d) {
      return d.keys().hasOnly(['routineId', 'days', 'planSrc', 'planReason', 'updatedAt'])
        && d.days is list && d.days.size() >= 1 && d.days.size() <= 7
        && d.planSrc in ['AI', 'LOCAL', 'PRESET']
        && d.planReason is string && d.planReason.size() <= 300;
    }

    match /plans/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, update: if (isOwner(userId) && validPlan(request.resource.data)) || isAdmin();
      allow delete: if isAdmin();
    }

    // ── workoutLogs ───────────────────────────────────────────────────────
    function validLog(d) {
      return d.keys().hasOnly([
        'userId', 'date', 'dayIdx', 'dayName', 'exercises', 'totalSets', 'totalVolume', 'durationSec', 'createdAt'
      ])
        && isDate(d.date)
        && d.dayIdx is int
        && d.dayName is string && d.dayName.size() <= 40
        && d.exercises is list && d.exercises.size() >= 1 && d.exercises.size() <= 30
        && d.totalSets is int && d.totalSets >= 0 && d.totalSets <= 500
        && d.totalVolume is number && d.totalVolume >= 0
        && d.durationSec is int && d.durationSec >= 0
        && isIso(d.createdAt);
    }

    match /workoutLogs/{logId} {
      // list 는 where('userId','==',uid) 로 필터된 쿼리만 통과한다
      allow read: if ownsExisting() || isAdmin();
      allow create: if (ownsIncoming() && validLog(request.resource.data)) || isAdmin();
      allow update: if (ownsExisting() && ownsIncoming() && validLog(request.resource.data)) || isAdmin();
      allow delete: if ownsExisting() || isAdmin();
    }

    // ── weights ───────────────────────────────────────────────────────────
    function validWeight(d) {
      return d.keys().hasOnly(['userId', 'date', 'kg', 'createdAt'])
        && isDate(d.date)
        && d.kg is number && d.kg > 0 && d.kg < 500
        && (!('createdAt' in d) || isIso(d.createdAt));
    }

    match /weights/{weightId} {
      allow read: if ownsExisting() || isAdmin();
      allow create: if (ownsIncoming() && validWeight(request.resource.data)) || isAdmin();
      allow update: if (ownsExisting() && ownsIncoming() && validWeight(request.resource.data)) || isAdmin();
      allow delete: if ownsExisting() || isAdmin();
    }

    // ── bodyAnalyses ──────────────────────────────────────────────────────
    // 온보딩 분석 결과(재분석마다 새 문서). 본인이 쓰지만 서버(projectStart)는 여기 적힌 계산 결과를
    // 믿지 않고 input · goal 만 꺼내 엔진으로 다시 계산한다 — 그래서 여기선 키 · 크기 · 형식만 막는다.
    function validAnalysis(d) {
      return d.keys().hasOnly([
        'userId', 'createdAt', 'engineVersion', 'input', 'comp', 'coord', 'cell', 'goal', 'gap',
        'order', 'track', 'reachedAt', 'projects', 'decision'
      ])
        && d.decision in ['pending', 'started', 'declined']
        && d.engineVersion is string && d.engineVersion.size() <= 20
        && d.input is map
        && d.track is list && d.track.size() <= 25
        && d.projects is list && d.projects.size() <= 2
        && isIso(d.createdAt);
    }

    match /bodyAnalyses/{analysisId} {
      allow read: if ownsExisting() || isAdmin();
      allow create: if (ownsIncoming() && validAnalysis(request.resource.data)) || isAdmin();
      allow update: if (ownsExisting() && ownsIncoming() && validAnalysis(request.resource.data)) || isAdmin();
      allow delete: if ownsExisting() || isAdmin();
    }

    // ── checkins ──────────────────────────────────────────────────────────
    // 4주 체크인. 본인이 쓰지만 체성분 · 진행률 · 상태는 서버(aiReport)가 다시 판정해 덮어쓰고,
    // 다음 판정도 서버가 쓴 리포트(bodyReports)의 값을 읽는다 — 여기 값을 고쳐도 판정은 바뀌지 않는다.
    function validCheckin(d) {
      return d.keys().hasOnly([
        'userId', 'projectId', 'date', 'createdAt', 'monthIndex', 'weightKg', 'waistCm', 'inbody',
        'comp', 'coord', 'cell', 'expectedProgressPct', 'measuredProgressPct', 'status', 'reportId'
      ])
        && d.projectId is string && d.projectId.size() <= 200
        && isDate(d.date)
        && isIso(d.createdAt)
        && d.monthIndex is int && d.monthIndex >= 0 && d.monthIndex <= 36
        && d.weightKg is number && d.weightKg >= 25 && d.weightKg <= 300
        && (!('waistCm' in d) || d.waistCm == null || (d.waistCm is number && d.waistCm >= 50 && d.waistCm <= 200))
        && (!('inbody' in d) || d.inbody == null || d.inbody is map)
        && d.status in ['ahead', 'on', 'behind'];
    }

    match /checkins/{checkinId} {
      allow read: if ownsExisting() || isAdmin();
      // reportId = 서버가 판정을 마쳤다는 표시. 클라이언트는 넣지도 바꾸지도 지우지도 못한다
      allow create: if (ownsIncoming()
                        && validCheckin(request.resource.data)
                        && (!('reportId' in request.resource.data) || request.resource.data.reportId == null))
                    || isAdmin();
      allow update: if (ownsExisting() && ownsIncoming()
                        && validCheckin(request.resource.data)
                        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['reportId']))
                    || isAdmin();
      allow delete: if ownsExisting() || isAdmin();
    }

    // ── bodyProjects · bodyReports ────────────────────────────────────────
    // 서버(projectStart · aiReport, Admin SDK)만 만들고 바꾼다. 본인은 읽기만 한다.
    // list 는 where('userId','==',uid) 로 필터된 쿼리만 통과한다.
    match /bodyProjects/{projectId} {
      allow read: if ownsExisting() || isAdmin();
      allow write: if isAdmin();
    }

    match /bodyReports/{reportId} {
      allow read: if ownsExisting() || isAdmin();
      allow write: if isAdmin();
    }

    // ── 구독 관련 컬렉션 ──────────────────────────────────────────────────
    // promoCodes / promoRedemptions / promoAttempts / subEvents 는 전부
    // Cloud Functions(Admin SDK) 전용이다. 앱에서는 읽지도 쓰지도 않는다.
    match /promoCodes/{code} { allow read, write: if isAdmin(); }
    match /promoRedemptions/{id} { allow read, write: if isAdmin(); }
    match /promoAttempts/{id} { allow read, write: if isAdmin(); }
    match /subEvents/{id} { allow read, write: if isAdmin(); }

    // ── 그 외 모든 경로 ───────────────────────────────────────────────────
    // 정의되지 않은 컬렉션은 관리자만 접근 가능
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
