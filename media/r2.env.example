# Cloudflare R2 — 운동 영상 업로드 키 (scripts/lib/r2.mjs)
# 이 파일을 media/r2.env 로 복사해 값을 채운다. media/r2.env 는 git 에 올라가지 않는다.
#
# 만드는 곳: Cloudflare › R2 Object Storage › Manage API tokens › Create Account API token
#   권한 Object Read & Write · 버킷 militarytracker 만 · TTL Forever
#   만든 직후 한 번만 보이는 Access Key ID · Secret Access Key 를 넣는다 (Token value 는 안 씀)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
